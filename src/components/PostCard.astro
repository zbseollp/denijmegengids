---
/**
 * News card used by /blog/, the homepage block and the related-posts strip.
 * The image only renders when the resolver returns a URL — an empty Payload
 * featuredImage must never produce a broken image icon.
 */
import { postImage, postImageAlt, postUrl, postDisplayDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
  loading?: 'lazy' | 'eager';
}

const { post, loading = 'lazy' } = Astro.props;
const image = postImage(post);
const alt = postImageAlt(post);
const date = postDisplayDate(post);
---
<a class="group block" href={postUrl(post)}>
  {image ? (
    <div class="rounded-xl overflow-hidden mb-3 bg-[color:var(--surface-muted)] aspect-[16/10]">
      <img
        src={image}
        alt={alt}
        loading={loading}
        decoding="async"
        width="640"
        height="400"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </div>
  ) : (
    <div class="rounded-xl mb-3 bg-[color:var(--color-brand-700)] h-1.5" aria-hidden="true"></div>
  )}
  <p class="font-semibold text-[color:var(--text-muted)] mb-1.5 text-xs">{date.toISOString().slice(0, 10)}</p>
  <h3 class="transition-colors font-semibold !leading-snug !text-lg dark:group-hover:text-brand-300 font-display group-hover:text-[color:var(--color-brand-700)] text-[color:var(--text)]">{post.data.title}</h3>
  <p class="text-sm text-[color:var(--text-muted)] mt-2 leading-relaxed line-clamp-2">{post.data.description}</p>
</a>
