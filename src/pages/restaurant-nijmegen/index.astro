        <span class="transition-colors font-bold font-display leading-tight text-xl tracking-tight md:text-2xl text-[color:var(--text)]">De<span class="text-[color:var(--color-accent-500)]">Nijmegen</span>Gids</span>
      </a>
      <nav aria-label="Hoofdmenu" class="items-center hidden gap-0.5 md:flex"><a class="transition-colors rounded-lg text-sm font-semibold px-3.5 py-2 hover:bg-[color:var(--surface-muted)] hover:text-[color:var(--text)] text-[color:var(--text-muted)]" href="/" >Home </a><a class="transition-colors rounded-lg text-sm font-semibold px-3.5 py-2 bg-[color:var(--color-brand-50)] dark:bg-brand-950/40 dark:text-brand-200 text-[color:var(--color-brand-800)]" href="/bedrijvengids/" >Bedrijvengids </a><a class="transition-colors rounded-lg text-sm font-semibold px-3.5 py-2 hover:bg-[color:var(--surface-muted)] hover:text-[color:var(--text)] text-[color:var(--text-muted)]" href="/blog/" >Nieuws </a><a class="transition-colors rounded-lg text-sm font-semibold px-3.5 py-2 hover:bg-[color:var(--surface-muted)] hover:text-[color:var(--text)] text-[color:var(--text-muted)]" href="/weer-nijmegen/" >Weer </a><a class="transition-colors rounded-lg text-sm font-semibold px-3.5 py-2 hover:bg-[color:var(--surface-muted)] hover:text-[color:var(--text)] text-[color:var(--text-muted)]" href="/112-nijmegen/" >112 Meldingen </a><a class="transition-colors rounded-lg text-sm font-semibold px-3.5 py-2 hover:bg-[color:var(--surface-muted)] hover:text-[color:var(--text)] text-[color:var(--text-muted)]" href="/contact/" >Contact </a></nav>
