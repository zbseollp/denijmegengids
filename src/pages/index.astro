---
export const prerender = true;
import { getRecentPosts } from '../lib/posts';
import PostCard from '../components/PostCard.astro';

// Was a hardcoded block of six articles: posts published after the migration
// never reached the homepage. Read the live collection instead.
const laatsteNieuws = await getRecentPosts(6);
---
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Nijmegen Laatste Nieuws - Dé digitale stadsgids van gemeente Nijmegen</title>
  <meta name="description" content="Al het laatste nieuws uit Nijmegen en omgeving? Ontdek het hier, de digitale gids van gemeente Nijmegen met bedrijven, nieuws en praktische informatie." />
  <link rel="canonical" href="https://denijmegengids.nl/" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/assets/gids2026.css" />
</head>
<body>
<a class="focus:bg-brand-600 focus:fixed focus:left-3 focus:not-sr-only focus:px-4 focus:py-2 focus:rounded focus:text-white focus:top-3 focus:z-50 sr-only" href="#main">Naar hoofdinhoud</a>
<header class="bg-[color:var(--surface)] border-[color:var(--color-brand-700)] border-b-2 sticky top-0 z-50">
  <div class="bg-[color:var(--color-brand-800)] text-white">
    <div class="items-center flex justify-between container-page font-medium py-1.5 text-[11px] tracking-wide">
      <span class="items-center inline-flex gap-1.5">Nijmegen &middot; gemeente Nijmegen</span>
      <span class="sm:inline hidden text-[color:var(--color-brand-200)]">De digitale stadsgids</span>
    </div>
  </div>
  <div class="container-page">
    <div class="items-center flex justify-between h-16 md:h-[4.5rem]">
      <a class="items-center inline-flex gap-2.5 group" href="/" aria-label="De Nijmegen Gids home">
        <svg aria-hidden="true" class="flex-shrink-0 h-9 md:h-10 md:w-10 w-9" fill="none" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect height="30" width="3" fill="var(--color-brand-700)" rx="1.5" x="18.5" y="6"></rect><path d="M8 9 H 29 L 34 13.5 L 29 18 H 8 Z" fill="var(--color-accent-500)"></path><path d="M32 21 H 12 L 7 25.5 L 12 30 H 32 Z" fill="var(--color-brand-600)"></path><rect height="2" width="14" fill="#fff" rx="1" x="11" y="12.5" opacity="0.9"></rect><rect height="2" width="13" fill="#fff" rx="1" x="15" y="24.5" opacity="0.9"></rect></svg>
        <span class="transition-colors font-bold font-display leading-tight text-xl tracking-tight md:text-2xl text-[color:var(--text)]">De<span class="text-[color:var(--color-accent-500)]">Nijmegen</span>Gids</span>
      </a>
      <nav aria-label="Hoofdmenu" class="items-center hidden gap-0.5 md:flex"><a class="transition-colors rounded-lg text-sm font-semibold px-3.5 py-2 bg-[color:var(--color-brand-50)] dark:bg-brand-950/40 dark:text-brand-200 text-[color:var(--color-brand-800)]" href="/" >Home </a><a class="transition-colors rounded-lg text-sm font-semibold px-3.5 py-2 hover:bg-[color:var(--surface-muted)] hover:text-[color:var(--text)] text-[color:var(--text-muted)]" href="/bedrijvengids/" >Bedrijvengids </a><a class="transition-colors rounded-lg text-sm font-semibold px-3.5 py-2 hover:bg-[color:var(--surface-muted)] hover:text-[color:var(--text)] text-[color:var(--text-muted)]" href="/blog/" >Nieuws </a><a class="transition-colors rounded-lg text-sm font-semibold px-3.5 py-2 hover:bg-[color:var(--surface-muted)] hover:text-[color:var(--text)] text-[color:var(--text-muted)]" href="/weer-nijmegen/" >Weer </a><a class="transition-colors rounded-lg text-sm font-semibold px-3.5 py-2 hover:bg-[color:var(--surface-muted)] hover:text-[color:var(--text)] text-[color:var(--text-muted)]" href="/112-nijmegen/" >112 Meldingen </a><a class="transition-colors rounded-lg text-sm font-semibold px-3.5 py-2 hover:bg-[color:var(--surface-muted)] hover:text-[color:var(--text)] text-[color:var(--text-muted)]" href="/contact/" >Contact </a></nav>
      <div class="items-center flex gap-2">
        <a class="transition-colors rounded-lg items-center font-bold text-white bg-[color:var(--color-accent-500)] h-9 hidden hover:bg-[color:var(--color-accent-600)] md:inline-flex px-4 text-xs" href="/contact/" >Bedrijf aanmelden</a>
      </div>
    </div>
  </div>
</header>
<main id="main">
<section class="relative bg-[color:var(--color-brand-800)] overflow-hidden text-white">
  <div class="container-page"><div class="relative max-w-3xl md:py-24 py-16">
    <span class="md:text-3xl plaatsbord text-2xl">Nijmegen</span>
    <h1 class="!leading-[1.08] !text-[clamp(2.2rem,1.5rem+3.2vw,3.9rem)] mt-7 text-balance text-white">Nijmegen laatste nieuws</h1>
    <p class="font-semibold font-display text-lg mt-3 text-[color:var(--color-accent-300)]">Nieuws uit de regio | Gemeente Nijmegen</p>
    <p class="leading-relaxed text-[color:var(--color-brand-100)] max-w-2xl md:text-xl mt-5 text-lg">Het laatste nieuws uit Nijmegen lees jij op deNijmegengids.nl. Wij plaatsen dagelijks het laatste nieuws uit de omgeving van Nijmegen. Opzoek naar een nieuwe baan? Wij delen de laatste vacatures uit de regio. Ook huizen die te koop staan, uitgegeven vergunningen en geplande evenementen lees jij op deze lokale nieuws site. Sla de website op in je favorieten en mis geen enkele update.</p>
    <div class="flex flex-wrap gap-3 mt-8">
      <a class="transition-colors rounded-lg items-center inline-flex text-sm font-bold px-6 h-12 bg-[color:var(--color-accent-300)] hover:bg-[color:var(--color-accent-200)] text-[color:var(--color-brand-900)]" href="/blog/" >Laatste nieuws Nijmegen </a>
      <a class="transition-colors rounded-lg items-center inline-flex text-sm font-bold px-6 h-12 border-2 border-[color:var(--color-brand-500)] hover:bg-[color:var(--color-brand-700)] text-white" href="/bedrijvengids/" >Bekijk de bedrijvengids</a>
    </div>
    <p class="text-sm text-[color:var(--color-brand-300)] mt-6">393 bedrijven &middot; 10 categorie&euml;n &middot; wekelijks bijgewerkt</p>
  </div></div>
</section>
<section class="bg-[color:var(--surface)] border-[color:var(--border)] section-pad border-y"><div class="container-page">
  <div class="kop-wijzer mb-2"><p class="text-xs font-bold uppercase text-[color:var(--color-accent-600)] tracking-[0.16em]">De gids</p></div>
  <div class="flex justify-between gap-3 flex-wrap items-end mb-8"><h2>Vind een&hellip;</h2><a class="text-sm dark:text-brand-300 font-bold hover:underline text-[color:var(--color-brand-700)] underline-offset-4" href="/bedrijvengids/" >Alle 393 bedrijven &rarr;</a></div>
  <div class="flex flex-wrap gap-2.5"><a class="transition-colors !px-4 !py-2 !text-sm dark:hover:!bg-ink-900 gids-chip hover:!bg-[color:var(--color-accent-50)] hover:!border-[color:var(--color-accent-400)]" href="/restaurant-nijmegen/" >Restaurant </a><a class="transition-colors !px-4 !py-2 !text-sm dark:hover:!bg-ink-900 gids-chip hover:!bg-[color:var(--color-accent-50)] hover:!border-[color:var(--color-accent-400)]" href="/pedicure-nijmegen/" >Pedicure </a><a class="transition-colors !px-4 !py-2 !text-sm dark:hover:!bg-ink-900 gids-chip hover:!bg-[color:var(--color-accent-50)] hover:!border-[color:var(--color-accent-400)]" href="/kapper-nijmegen/" >Kapper </a><a class="transition-colors !px-4 !py-2 !text-sm dark:hover:!bg-ink-900 gids-chip hover:!bg-[color:var(--color-accent-50)] hover:!border-[color:var(--color-accent-400)]" href="/sportschool-nijmegen/" >Sport </a><a class="transition-colors !px-4 !py-2 !text-sm dark:hover:!bg-ink-900 gids-chip hover:!bg-[color:var(--color-accent-50)] hover:!border-[color:var(--color-accent-400)]" href="/tandarts-nijmegen/" >Tandarts </a><a class="transition-colors !px-4 !py-2 !text-sm dark:hover:!bg-ink-900 gids-chip hover:!bg-[color:var(--color-accent-50)] hover:!border-[color:var(--color-accent-400)]" href="/fotograaf-nijmegen/" >Fotograaf </a><a class="transition-colors !px-4 !py-2 !text-sm dark:hover:!bg-ink-900 gids-chip hover:!bg-[color:var(--color-accent-50)] hover:!border-[color:var(--color-accent-400)]" href="/fysio-nijmegen/" >Fysiotherapie </a><a class="transition-colors !px-4 !py-2 !text-sm dark:hover:!bg-ink-900 gids-chip hover:!bg-[color:var(--color-accent-50)] hover:!border-[color:var(--color-accent-400)]" href="/rijschool-nijmegen/" >Rijschool </a><a class="transition-colors !px-4 !py-2 !text-sm dark:hover:!bg-ink-900 gids-chip hover:!bg-[color:var(--color-accent-50)] hover:!border-[color:var(--color-accent-400)]" href="/kinderdagopvang-nijmegen/" >Kinderopvang </a><a class="transition-colors !px-4 !py-2 !text-sm dark:hover:!bg-ink-900 gids-chip hover:!bg-[color:var(--color-accent-50)] hover:!border-[color:var(--color-accent-400)]" href="/notaris-nijmegen/" >Notaris </a></div>
</div></section>
<section class="section-pad bg-[color:var(--bg)]"><div class="container-page">
  <div class="kop-wijzer mb-2"><p class="text-xs font-bold uppercase text-[color:var(--color-accent-600)] tracking-[0.16em]">Bedrijvengids</p></div>
  <div class="flex justify-between gap-3 flex-wrap items-end mb-8"><h2>Lokale bedrijven.</h2></div>
  <div class="grid gap-4 lg:grid-cols-3 sm:grid-cols-2"><a class="block wijzer-card" href="/-india-gate-tandoori-indian-restaurant/" ><p class="gids-chip mb-2.5">Restaurant</p><h3 class="font-semibold text-[color:var(--text)] font-display !leading-snug !text-lg">“India Gate” Tandoori Indian Restaurant</h3><p class="text-sm text-[color:var(--text-muted)] gap-1.5 inline-flex items-center mt-1.5">Molenstraat 136</p></a><a class="block wijzer-card" href="/-/" ><p class="gids-chip mb-2.5">Lokale onderneming</p><h3 class="font-semibold text-[color:var(--text)] font-display !leading-snug !text-lg">ماركت الكرامة السوري</h3><p class="text-sm text-[color:var(--text-muted)] gap-1.5 inline-flex items-center mt-1.5">Symfoniestraat 130</p></a><a class="block wijzer-card" href="/-turkish-mosque/" ><p class="gids-chip mb-2.5">Lokale onderneming</p><h3 class="font-semibold text-[color:var(--text)] font-display !leading-snug !text-lg">مسجد الفاتح ك Turkish Mosque</h3><p class="text-sm text-[color:var(--text-muted)] gap-1.5 inline-flex items-center mt-1.5">Krekelstraat 6</p></a><a class="block wijzer-card" href="/10kb/" ><p class="gids-chip mb-2.5">Lokale onderneming</p><h3 class="font-semibold text-[color:var(--text)] font-display !leading-snug !text-lg">10KB</h3><p class="text-sm text-[color:var(--text-muted)] gap-1.5 inline-flex items-center mt-1.5">Gorterplaats 10</p></a><a class="block wijzer-card" href="/10xbeter-marketing/" ><p class="gids-chip mb-2.5">Marketing &amp; IT</p><h3 class="font-semibold text-[color:var(--text)] font-display !leading-snug !text-lg">10xbeter Marketing</h3><p class="text-sm text-[color:var(--text-muted)] gap-1.5 inline-flex items-center mt-1.5">Hogelandseweg 60</p></a><a class="block wijzer-card" href="/3p-fotografie/" ><p class="gids-chip mb-2.5">Fotograaf</p><h3 class="font-semibold text-[color:var(--text)] font-display !leading-snug !text-lg">3P Fotografie</h3><p class="text-sm text-[color:var(--text-muted)] gap-1.5 inline-flex items-center mt-1.5">Heeskesacker 2227</p></a></div>
  <div class="mt-8"><a class="transition-colors rounded-lg items-center inline-flex text-sm font-bold px-6 text-white bg-[color:var(--color-brand-700)] h-11 hover:bg-[color:var(--color-brand-800)]" href="/bedrijvengids/" >Naar de volledige bedrijvengids</a></div>
</div></section>
<section class="bg-[color:var(--surface)] border-[color:var(--border)] border-t section-pad"><div class="container-page">
  <div class="kop-wijzer mb-2"><p class="text-xs font-bold uppercase text-[color:var(--color-accent-600)] tracking-[0.16em]">Actueel</p></div>
  <div class="flex justify-between gap-3 flex-wrap items-end mb-8"><h2>Laatste nieuws Nijmegen</h2><a class="text-sm dark:text-brand-300 font-bold hover:underline text-[color:var(--color-brand-700)] underline-offset-4" href="/blog/" >Alle berichten &rarr;</a></div>
  <div class="grid lg:grid-cols-3 sm:grid-cols-2 gap-x-6 gap-y-8">
    {laatsteNieuws.map((post, i) => (
      <PostCard post={post} loading={i < 3 ? 'eager' : 'lazy'} />
    ))}
  </div>
</div></section>
<section class="section-pad bg-[color:var(--bg)] border-[color:var(--border)] border-t"><div class="container-page">
  <div class="grid gap-10 lg:gap-16 max-w-5xl md:grid-cols-2">
    <div><h2 class="mb-4 !text-2xl md:!text-3xl">Laatste nieuws Nijmegen vandaag</h2><p class="leading-relaxed text-[color:var(--text)]">Wij zijn opzoek naar vrijwilligers die willen helpen om van deNijmegengids.nl dé nieuws website van de gemeente Nijmegen willen maken. Kom jij uit Nijmegen en heb jij een passie voor nieuws en de lokale community? Neem dan contact met ons op om te bespreken wat jij voor deNijmegengids.nl kunt betekenen.</p><p class="text-lg font-display italic mt-4 text-[color:var(--text-muted)]">Op deNijmegengids.nl lees jij altijd het laatste nieuws uit de omgeving. Of je nou benieuwd bent naar waar de politie, brandweer &amp; ambulance druk mee is of opzoek bent naar een nieuwe baan. Wij staan dichtbij de lokale community. DeNijmegengids.nl is een initiatief om positief nieuws uit te brengen op lokaal niveau. Geen afstand met de burger, maar nieuws dat directe invloed heeft op jouw leven! Daarnaast werken wij samen met vele lokale organisaties en bedrijven om jou van de juiste informatie te voorzien.</p></div>
    <div><h2 class="mb-4 !text-2xl md:!text-3xl">Nieuws Nijmegen inzenden</h2><p class="leading-relaxed text-[color:var(--text)]">Het plaatsen van nieuws op deNijmegengids.nl is voor lokale organisaties volledig gratis! Heb jij berichten over je vereniging, wil je een vrijwilliger in het zonnetje zetten of viel er wat te vieren? Verwerk het in een nieuwsbericht en deel het met onze redactie. Voor commerciële berichten vragen wij een vergoeding, neem contact met ons op voor de voorwaarden.</p><a class="transition-colors rounded-lg items-center inline-flex text-sm font-bold px-6 text-white bg-[color:var(--color-brand-700)] h-11 hover:bg-[color:var(--color-brand-800)] mt-5" href="/contact/" >Contact opnemen</a></div>
  </div>
</div></section>
<section class="section-pad bg-[color:var(--bg)]"><div class="container-page">
  <div class="relative bg-[color:var(--color-brand-800)] overflow-hidden text-white md:p-12 p-8 rounded-2xl"><div class="relative max-w-2xl">
    <h2 class="!text-white">Staat jouw bedrijf nog niet in de gids?</h2>
    <p class="leading-relaxed text-[color:var(--color-brand-100)] mt-3">Meld je bedrijf gratis aan voor de bedrijvengids van Nijmegen. Zichtbaar voor iedereen die lokaal zoekt.</p>
    <a class="transition-colors rounded-lg items-center inline-flex text-sm font-bold px-6 h-12 bg-[color:var(--color-accent-300)] hover:bg-[color:var(--color-accent-200)] text-[color:var(--color-brand-900)] mt-6" href="/contact/" >Bedrijf aanmelden</a>
  </div></div>
</div></section>
</main>
<footer class="bg-[color:var(--color-brand-900)] mt-24 text-[color:var(--color-brand-100)]">
  <div class="container-page md:py-16 py-14">
    <div class="grid gap-10 border-[color:var(--color-brand-700)] border-b mb-8 md:grid-cols-12 pb-10">
      <div class="md:col-span-4">
        <a class="items-center inline-flex gap-2.5 group" href="/" aria-label="De Nijmegen Gids home"><svg aria-hidden="true" class="flex-shrink-0 h-10 w-10" fill="none" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><rect height="30" width="3" fill="#ffffff" rx="1.5" x="18.5" y="6"></rect><path d="M8 9 H 29 L 34 13.5 L 29 18 H 8 Z" fill="var(--color-accent-500)"></path><path d="M32 21 H 12 L 7 25.5 L 12 30 H 32 Z" fill="#ffffff"></path></svg><span class="transition-colors font-bold text-white font-display leading-tight text-xl tracking-tight">De<span class="text-[color:var(--color-accent-500)]">Nijmegen</span>Gids</span></a>
        <p class="text-sm leading-relaxed max-w-xs mt-4 text-[color:var(--color-brand-200)]">De digitale stadsgids van Nijmegen. Lokale bedrijven, nieuws en praktische informatie op &eacute;&eacute;n plek.</p>
      </div>
      <div class="md:col-span-3"><p class="text-xs font-bold uppercase mb-4 text-[color:var(--color-accent-300)] tracking-[0.14em]">In de gids</p><ul class="text-sm space-y-2 columns-2 md:columns-1"><li><a class="transition-colors hover:text-white" href="/restaurant-nijmegen/">Restaurant</a></li><li><a class="transition-colors hover:text-white" href="/pedicure-nijmegen/">Pedicure</a></li><li><a class="transition-colors hover:text-white" href="/kapper-nijmegen/">Kapper</a></li><li><a class="transition-colors hover:text-white" href="/sportschool-nijmegen/">Sport</a></li><li><a class="transition-colors hover:text-white" href="/tandarts-nijmegen/">Tandarts</a></li><li><a class="transition-colors hover:text-white" href="/fotograaf-nijmegen/">Fotograaf</a></li><li><a class="transition-colors hover:text-white" href="/fysio-nijmegen/">Fysiotherapie</a></li><li><a class="transition-colors hover:text-white" href="/rijschool-nijmegen/">Rijschool</a></li></ul></div>
      <div class="md:col-span-3"><p class="text-xs font-bold uppercase mb-4 text-[color:var(--color-accent-300)] tracking-[0.14em]">Praktisch</p><ul class="text-sm space-y-2">
        <li><a class="transition-colors hover:text-white" href="/112-nijmegen/">112 Meldingen</a></li>
        <li><a class="transition-colors hover:text-white" href="/weer-nijmegen/">Het weer</a></li>
        <li><a class="transition-colors hover:text-white" href="/funda-nijmegen/">Huizen te koop</a></li>
        <li><a class="transition-colors hover:text-white" href="/vacatures-nijmegen/">Vacatures</a></li>
        <li><a class="transition-colors hover:text-white" href="/bekendmakingen/">Bekendmakingen</a></li>
      </ul></div>
      <div class="md:col-span-2"><p class="text-xs font-bold uppercase mb-4 text-[color:var(--color-accent-300)] tracking-[0.14em]">Site</p><ul class="text-sm space-y-2">
        <li><a class="transition-colors hover:text-white" href="/bedrijvengids/">Bedrijvengids</a></li>
        <li><a class="transition-colors hover:text-white" href="/blog/">Nieuws</a></li>
        <li><a class="transition-colors hover:text-white" href="/contact/">Contact</a></li>
      </ul></div>
    </div>
    <div class="text-xs flex flex-col gap-3 items-start justify-between md:flex-row md:items-center text-[color:var(--color-brand-300)]">
      <p>&copy; <span data-current-year>2026</span>&nbsp;De Nijmegen Gids &middot; denijmegengids.nl</p>
      <p><a class="transition-colors hover:text-white" href="/sitemap/">Sitemap</a></p>
    </div>
  </div>
</footer>
<script>document.querySelectorAll("[data-current-year]").forEach(e=>{e.textContent=(new Date()).getFullYear().toString()})</script>
</body>
</html>
