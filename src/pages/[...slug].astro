---
export const prerender = true;
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../layouts/BlogPostLayout.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const alleBlogs = await getCollection('blog');
const idx = alleBlogs.findIndex((p) => p.id === entry.id);
const gerelateerd = Array.from({ length: 3 }, (_, i) => alleBlogs[(idx + i + 1) % alleBlogs.length])
  .filter((p) => p.id !== entry.id);
---
<BlogPostLayout title={entry.data.title} description={entry.data.description}>
  <p style="font-size:0.8rem;font-weight:600;color:var(--text-muted);margin-top:-1rem;margin-bottom:1.5rem">{entry.data.pubDate.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
  <Content />
  <Fragment slot="after">
    <section class="bg-[color:var(--surface)] border-[color:var(--border)] border-t section-pad"><div class="container-page">
      <div class="kop-wijzer mb-2"><p class="text-xs font-bold uppercase text-[color:var(--color-accent-600)] tracking-[0.16em]">Meer nieuws</p></div>
      <div class="grid lg:grid-cols-3 gap-x-6 gap-y-8">
        {gerelateerd.map((post) => (
          <a class="group block" href={`/${post.id}/`}>
            <p class="font-semibold text-[color:var(--text-muted)] mb-1.5 text-xs">{post.data.pubDate.toISOString().slice(0, 10)}</p>
            <h3 class="transition-colors font-semibold !leading-snug !text-lg dark:group-hover:text-brand-300 font-display group-hover:text-[color:var(--color-brand-700)] text-[color:var(--text)]">{post.data.title}</h3>
            <p class="text-sm text-[color:var(--text-muted)] mt-2 leading-relaxed line-clamp-2">{post.data.description}</p>
          </a>
        ))}
      </div>
    </div></section>
  </Fragment>
</BlogPostLayout>
